{
  "name": "tokenx",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Fast token estimation for text, AI SDK messages and tool schemas",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/tokenx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/tokenx.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/tokenx/issues"
  },
  "keywords": [
    "ai",
    "cli",
    "llm",
    "token",
    "tokenizer",
    "estimation",
    "tiktoken",
    "anthropic",
    "openai"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "tokenx": "bin/tokenx.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "node ./src/cli/entry.ts --help",
    "bench": "node scripts/generate-bench.ts && automd",
    "bench:png": "node scripts/render-bench.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "bumpp",
    "bench:speed": "vitest bench --run bench/"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^26.1.2",
    "ai": "^7.0.126",
    "ai-tokenizer": "^1.0.7",
    "ansis": "^4.3.1",
    "automd": "^0.4.3",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.0",
    "eslint-flat-config-utils": "^3.2.0",
    "gpt-tokenizer": "^3.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "utilful": "^3.3.0",
    "vitest": "^4.1.10",
    "zod": "^4.6.5"
  }
}
